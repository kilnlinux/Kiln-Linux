# Kiln Linux dunst config (notifications in the twmx and i3 desktops). Reference: man 5 dunst
[global]
    font = @font_sans@ @font_size@
    width = 360
    # y 28: below the 22 px bar, plus the 6 px gap; dunst ignores bar struts
    offset = (@gap@, 28)
    padding = 12
    horizontal_padding = 12
    frame_width = @border@
    frame_color = "#@line@"
    separator_color = frame
    background = "#@surface@"
    foreground = "#@fg@"
    highlight = "#@accent@"
    corner_radius = 0

[urgency_low]
    foreground = "#@muted@"

[urgency_critical]
    frame_color = "#@urgent@"
    timeout = 0
