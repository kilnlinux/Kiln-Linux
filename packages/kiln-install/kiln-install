#!/usr/bin/env bash
# kiln-install: install Kiln Linux from the live ISO, in the style of Void's
# installer: a main menu of settings you can visit in any order, then Install.
#
#   kiln-install                  menu-driven, with dialog
#   kiln-install --config FILE    unattended: FILE sets the variables below
#                                 (bash syntax), then the install runs as-is
#
# The install itself: GPT disk (or partitions you made with cfdisk), pacstrap
# of base + kernel, optional LUKS2 encryption of the root partition, Kiln
# profiles applied with `kiln apply` inside the new system, a boot loader
# (systemd-boot, GRUB or Limine; GRUB and Limine also on BIOS), then checks of
# the result. Nothing reports success unless those checks pass.

set -uo pipefail

readonly MNT=/mnt
readonly SHARE=/usr/share/kiln
readonly LOG=/tmp/kiln-install.log
readonly BT="Kiln Linux installer"
readonly CRYPT_NAME=kilnroot   # /dev/mapper name of the unlocked root
readonly MIN_BYTES=$((8 * 1024 * 1024 * 1024))
# GPT type of the BIOS boot partition, where GRUB and Limine put their BIOS stage 2.
readonly BIOS_BOOT_TYPE=21686148-6449-6e61-6e6f-744e656564ef
if [[ -d /sys/firmware/efi/efivars ]]; then FIRMWARE=uefi; else FIRMWARE=bios; fi
readonly FIRMWARE

# Settings. --config files set these.
KEYMAP=us
HOSTNAME_NEW=kiln
LOCALE=en_US.UTF-8
TIMEZONE=UTC
ROOT_PW=          # empty: root account locked, use sudo
USER_NAME=
USER_PW=
DESKTOP=twmx      # a key of DESKTOPS below
KERNEL=linux      # a key of KERNELS below
EXTRAS=()         # extra profiles: audio, developer
DISK=
SCHEME=           # auto (erase DISK) or manual (ESP and ROOT as given)
ESP=              # FAT32 partition mounted at /boot; the EFI system partition on UEFI
ROOT=
FORMAT_ESP=yes
FS=ext4           # root filesystem: ext4 or btrfs
ENCRYPT=no        # yes: LUKS2 on the root partition, unlocked at boot
LUKS_PW=          # passphrase for ENCRYPT=yes
BOOTLOADER=systemd-boot  # systemd-boot (UEFI only), grub or limine
[[ $FIRMWARE == uefi ]] || BOOTLOADER=grub

UNATTENDED=

# Desktop choices: key | menu label | kiln profile ("-": none) |
# display manager to enable ("-": none) | what the user does after reboot |
# command a tty1 login runs to start the desktop ("-": none).
DESKTOPS=(
    "twmx|twmx: tiling, X11 (Kiln default)|twmx|-|log in on tty1 and twmx starts|startx"
    "i3|i3: tiling, X11|i3|-|log in on tty1 and i3 starts|startx"
    "sway|Sway: tiling, Wayland|sway|-|log in on tty1 and sway starts|sway"
    "hyprland|Hyprland: tiling, Wayland|hyprland|-|log in on tty1 and Hyprland starts|start-hyprland"
    "xfce|XFCE: desktop environment, X11|xfce|lightdm|log in on the LightDM screen|-"
    "plasma|KDE Plasma: desktop environment, Wayland|plasma|sddm|log in on the SDDM screen|-"
    "gnome|GNOME: desktop environment, Wayland|gnome|gdm|log in on the GDM screen|-"
    "none|None: command line only|-|-|log in on the console|-"
)

# Kernels from Arch's repositories: package | menu label. Each installs
# /boot/vmlinuz-PACKAGE and /boot/initramfs-PACKAGE.img.
KERNELS=(
    "linux|Linux: the latest stable kernel (default)"
    "linux-lts|LTS: long-term support, fewer changes"
    "linux-zen|Zen: tuned for desktop responsiveness"
    "linux-hardened|Hardened: security patches; some apps may break"
)

# desktop_field KEY N: field N (1-based) of KEY's DESKTOPS entry.
desktop_field() {
    local e
    for e in "${DESKTOPS[@]}"; do
        if [[ ${e%%|*} == "$1" ]]; then
            cut -d'|' -f"$2" <<<"$e"
            return 0
        fi
    done
    return 1
}

d() { dialog --stdout --backtitle "$BT" "$@"; }

msg() {
    if [[ -n $UNATTENDED ]]; then printf '%s\n' "$*"; else d --msgbox "$*" 10 64; fi
}

die() {
    if [[ -n $UNATTENDED ]]; then
        printf 'kiln-install: %s\n' "$*" >&2
    else
        d --title Error --msgbox "$*" 10 64
        clear
    fi
    exit 1
}

# Full path of the Nth partition of a disk (sda1, nvme0n1p1, ...).
part() { lsblk -lnpo NAME,TYPE "$1" | awk '$2 == "part" { print $1 }' | sed -n "${2}p"; }

# The disk the ISO is running from, if any, so it is never offered.
live_disk() {
    local src pk
    src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null) || return 0
    pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1)
    if [[ -n $pk ]]; then
        printf '/dev/%s\n' "$pk"
    elif [[ $(lsblk -dno TYPE "$src" 2>/dev/null) == disk ]]; then
        printf '%s\n' "$src"
    fi
}

online() { getent hosts archlinux.org >/dev/null; }

# --- Menu items --------------------------------------------------------------

ask_keymap() {
    local k
    # shellcheck disable=SC2046
    k=$(d --title Keyboard --default-item "$KEYMAP" --no-items \
        --menu "Console keyboard layout:" 20 50 12 $(localectl list-keymaps)) || return
    KEYMAP=$k
    loadkeys "$KEYMAP" 2>/dev/null
}

ask_network() {
    if online; then
        d --title Network --msgbox "Connected to the internet.\n\nEthernet connects automatically." 8 50
        return
    fi
    d --title Network --yesno "Not connected. Ethernet connects automatically over DHCP.\n\nOpen iwctl to connect to Wi-Fi?\n(In iwctl: station wlan0 connect <network>, then exit.)" 11 64 || return
    clear
    iwctl
    online || d --title Network --msgbox "Still not connected." 6 40
}

ask_hostname() {
    local h
    while h=$(d --title Hostname --inputbox "Name for this computer:" 8 50 "$HOSTNAME_NEW"); do
        if [[ $h =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
            HOSTNAME_NEW=$h
            return
        fi
        d --msgbox "Use lowercase letters, digits and hyphens, not at the start or end." 6 70
    done
}

ask_locale() {
    local l
    # shellcheck disable=SC2046
    l=$(d --title Locale --default-item "$LOCALE" --no-items \
        --menu "System language and character set:" 20 50 12 \
        $(awk '$2 == "UTF-8" { print $1 }' /usr/share/i18n/SUPPORTED)) || return
    LOCALE=$l
}

ask_timezone() {
    local z=/usr/share/zoneinfo region city
    # shellcheck disable=SC2046
    region=$(d --title Timezone --no-items --menu "Region:" 20 50 12 UTC \
        $(cd "$z" && find . -mindepth 1 -maxdepth 1 -type d -name '[A-Z]*' ! -name Etc -printf '%f\n' | sort)) || return
    if [[ $region == UTC ]]; then
        TIMEZONE=UTC
        return
    fi
    # shellcheck disable=SC2046
    city=$(d --title Timezone --no-items --menu "City in $region:" 20 50 12 \
        $(cd "$z/$region" && find . -type f -printf '%P\n' | sort)) || return
    TIMEZONE=$region/$city
}

# ask_password TITLE TEXT: ask twice, print it. Fails on cancel.
ask_password() {
    local a b
    while true; do
        a=$(d --insecure --title "$1" --passwordbox "$2" 9 56) || return 1
        b=$(d --insecure --title "$1" --passwordbox "Again, to confirm:" 8 56) || return 1
        if [[ -z $a ]]; then
            d --msgbox "The password can't be empty." 6 40
        elif [[ $a != "$b" ]]; then
            d --msgbox "The passwords don't match." 6 40
        else
            printf '%s' "$a"
            return 0
        fi
    done
}

ask_root_password() {
    local answer
    d --title "Root password" --yes-label "Lock root" --no-label "Set password" --yesno \
        "Lock the root account? Your user gets sudo either way.\n\nA root password lets you log in to systemd's emergency shell." 10 60
    answer=$?
    case $answer in
        0) ROOT_PW= ;;
        1)
            local p
            p=$(ask_password "Root password" "Password for the root account:") && ROOT_PW=$p
            ;;
        *) return ;;
    esac
}

ask_user() {
    local u p
    while u=$(d --title "User account" --inputbox \
        "Login name for your account. It can administer the system with sudo." 9 60 "$USER_NAME"); do
        if [[ $u =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && ! getent passwd "$u" >/dev/null; then
            p=$(ask_password "User account" "Password for $u:") || return
            USER_NAME=$u USER_PW=$p
            return
        fi
        d --msgbox "Use lowercase letters, digits, - and _, starting with a letter, and not a system account name." 7 66
    done
}

ask_desktop() {
    local items=() e key
    for e in "${DESKTOPS[@]}"; do
        items+=("${e%%|*}" "$(cut -d'|' -f2 <<<"$e")")
    done
    key=$(d --title Desktop --default-item "$DESKTOP" \
        --menu "Desktop to install. You can add or switch later with kiln." 18 66 8 "${items[@]}") || return
    DESKTOP=$key
}

ask_kernel() {
    local items=() e k
    for e in "${KERNELS[@]}"; do items+=("${e%%|*}" "${e#*|}"); done
    k=$(d --title Kernel --default-item "$KERNEL" --menu "Kernel to install:" 12 66 4 "${items[@]}") || return
    KERNEL=$k
}

ask_extras() {
    local on_a=off on_d=off sel
    [[ " ${EXTRAS[*]} " == *" audio "* ]] && on_a=on
    [[ " ${EXTRAS[*]} " == *" developer "* ]] && on_d=on
    sel=$(d --title Extras --separate-output --checklist "Extra Kiln profiles (space to toggle):" 11 66 2 \
        audio "PipeWire audio" "$on_a" \
        developer "git, base-devel (gcc, make), gdb" "$on_d") || return
    EXTRAS=()
    [[ -z $sel ]] || mapfile -t EXTRAS <<<"$sel"
}

ask_disk() {
    local items=() name size model live
    live=$(live_disk)
    while read -r name size model; do
        [[ $name == "$live" || $name == /dev/zram* ]] && continue
        items+=("$name" "$size ${model:-}")
    done < <(lsblk -dpno NAME,SIZE,MODEL -e 1,7,11)
    ((${#items[@]})) || { d --msgbox "No disks found." 6 30; return; }
    name=$(d --title Disk --menu "Disk to install to:${live:+\n(The install medium, $live, is not listed.)}" 15 64 6 "${items[@]}") || return
    DISK=$name
    if ! check_disk_usable; then DISK=; return; fi

    SCHEME=$(d --title Partitions --menu "How to partition $DISK:" 12 72 2 \
        auto "Erase the whole disk: 1 GiB boot partition + root" \
        manual "Edit partitions with cfdisk, then choose them") || { DISK=; return; }
    ESP= ROOT= FORMAT_ESP=yes
    if [[ $SCHEME == manual ]]; then
        cfdisk "$DISK"
        local parts=() fstype
        while read -r name size fstype; do
            parts+=("$name" "$size ${fstype:-}")
        done < <(lsblk -lnpo NAME,SIZE,FSTYPE,TYPE "$DISK" | awk '$NF == "part" { NF--; print }')
        ((${#parts[@]} >= 4)) || { d --msgbox "Make at least two partitions: a boot partition (the EFI system partition on UEFI) and a root." 8 64; DISK=; return; }
        ESP=$(d --title Partitions --menu "Boot partition (FAT32, mounted at /boot, 512 MiB or more; on UEFI the EFI system partition):" 15 64 6 "${parts[@]}") || { DISK=; return; }
        ROOT=$(d --title Partitions --menu "Root partition (will be formatted):" 15 60 6 "${parts[@]}") || { DISK=; return; }
        [[ $ESP != "$ROOT" ]] || { d --msgbox "The boot and root partitions must be different." 6 56; DISK=; return; }
        if d --title Partitions --defaultno --yesno \
            "Format $ESP?\n\nSay no to keep it, for example to share it with another operating system." 9 64; then
            FORMAT_ESP=yes
        else
            FORMAT_ESP=no
        fi
    fi
    FS=$(d --title Filesystem --default-item "$FS" --menu "Root filesystem:" 10 56 2 \
        ext4 "simple and robust" btrfs "checksums, compression") || FS=ext4
    ENCRYPT=no LUKS_PW=
    if d --title Encryption --defaultno --yesno \
        "Encrypt the root partition (LUKS2)?\n\nYou type the passphrase at every boot. Lose it and the data is gone. The EFI partition stays unencrypted." 10 64; then
        local p
        p=$(ask_password Encryption "Disk encryption passphrase:") && ENCRYPT=yes LUKS_PW=$p
    fi
}

ask_bootloader() {
    local items=() b
    [[ $FIRMWARE == uefi ]] && items+=(systemd-boot "small, part of systemd; UEFI only")
    items+=(grub "GRUB: the most widely used; BIOS and UEFI")
    items+=(limine "Limine: small and fast; BIOS and UEFI")
    b=$(d --title "Boot loader" --default-item "$BOOTLOADER" \
        --menu "Boot loader (this computer started in ${FIRMWARE^^} mode):" 12 66 3 "${items[@]}") || return
    BOOTLOADER=$b
}

# --- Checks ------------------------------------------------------------------

# Prints why DISK can't be used; prints nothing if it can.
disk_problem() {
    if [[ ! -b $DISK ]]; then echo "Choose a disk first."
    elif [[ $(lsblk -dnro TYPE "$DISK") != disk ]]; then echo "$DISK is not a whole disk."
    elif [[ $DISK == "$(live_disk)" ]]; then echo "$DISK is the install medium."
    elif [[ -n $(lsblk -nrpo MOUNTPOINTS "$DISK" | tr -d '[:space:]') ]]; then
        echo "$DISK has mounted filesystems or swap. Unmount them first (umount -R $MNT)."
    elif (($(lsblk -bdno SIZE "$DISK") < MIN_BYTES)); then echo "$DISK is smaller than 8 GiB."
    fi
}

check_disk_usable() {
    local p
    p=$(disk_problem)
    [[ -z $p ]] && return 0
    msg "$p"
    return 1
}

# Prints the first problem with the settings; prints nothing if ready.
settings_problem() {
    local p
    case $BOOTLOADER in
        systemd-boot) [[ $FIRMWARE == uefi ]] || { echo "This computer started in BIOS mode; systemd-boot needs UEFI. Choose GRUB or Limine."; return; } ;;
        grub | limine) ;;
        *) echo "BOOTLOADER must be systemd-boot, grub or limine."; return ;;
    esac
    [[ -n $USER_NAME && -n $USER_PW ]] || { echo "Create a user account first."; return; }
    desktop_field "$DESKTOP" 1 >/dev/null || { echo "Unknown desktop: $DESKTOP"; return; }
    [[ " ${KERNELS[*]%%|*} " == *" $KERNEL "* ]] || { echo "KERNEL must be one of: ${KERNELS[*]%%|*}"; return; }
    for p in core "$(desktop_field "$DESKTOP" 3)" "${EXTRAS[@]}"; do
        [[ $p == - || -f $SHARE/profiles/$p.toml ]] || { echo "Missing profile $SHARE/profiles/$p.toml"; return; }
    done
    [[ $FS == ext4 || $FS == btrfs ]] || { echo "FS must be ext4 or btrfs."; return; }
    case $ENCRYPT in
        no) ;;
        yes) [[ -n $LUKS_PW ]] || { echo "Set an encryption passphrase (see Disk)."; return; } ;;
        *) echo "ENCRYPT must be yes or no."; return ;;
    esac
    [[ ! -e /dev/mapper/$CRYPT_NAME ]] || { echo "/dev/mapper/$CRYPT_NAME is open; close it first (cryptsetup close $CRYPT_NAME)."; return; }
    p=$(disk_problem)
    [[ -z $p ]] || { echo "$p"; return; }
    case $SCHEME in
        auto) ;;
        manual)
            for p in "$ESP" "$ROOT"; do
                [[ -b $p && $(lsblk -dnro TYPE "$p") == part && $(lsblk -dnpro PKNAME "$p") == "$DISK" ]] ||
                    { echo "Choose partitions on $DISK."; return; }
            done
            [[ $ESP != "$ROOT" ]] || { echo "The boot and root partitions must be different."; return; }
            [[ $FORMAT_ESP == yes || $FORMAT_ESP == no ]] || { echo "FORMAT_ESP must be yes or no."; return; }
            if [[ $FIRMWARE == bios && $(lsblk -dno PTTYPE "$DISK") == gpt && -z $(bios_boot_part) ]]; then
                echo "BIOS booting from a GPT disk needs a BIOS boot partition (1 MiB, type \"BIOS boot\" in cfdisk)."; return
            fi
            ;;
        *) echo "Choose how to partition the disk."; return ;;
    esac
    online || { echo "No internet connection (see Network)."; return; }
    systemctl is-active -q pacman-init.service || echo "The pacman keyring is still initializing; try again in a moment."
}

# --- Install -----------------------------------------------------------------
# install_all runs in a subshell with -e: any failing command stops it, and
# do_install reports the failure. Output goes to the screen and the log.

run() { printf '$ %s\n' "$*"; "$@"; }

# Retry only download failures; keep transaction and signature errors fatal.
retry_downloads() {
    local mirrorlist=$1 attempt output rc replacement server
    local -a status
    shift
    output=$(mktemp) || return 1
    for attempt in 1 2 3; do
        if (
            # Changing mirrors requires fresh databases and a full upgrade.
            if ((attempt > 1)) && [[ $1 == arch-chroot ]]; then
                LC_ALL=C run arch-chroot "$MNT" pacman -Syyu --noconfirm || exit $?
            fi
            LC_ALL=C run "$@"
        ) 2>&1 | tee "$output"; then
            rm -f "$output"
            return 0
        else
            status=("${PIPESTATUS[@]}")
        fi
        rc=${status[0]}
        if ((status[1] != 0)); then rm -f "$output"; return 1; fi
        if ((attempt == 3)) ||
            grep -Eq 'PGP signature|signature.*unknown trust|failed to prepare transaction|could not lock database|conflicting files|target not found:' "$output" ||
            ! grep -Eq 'failed retrieving file|failed to retrieve some files|failed to synchronize all databases' "$output"; then
            rm -f "$output"
            return "$rc"
        fi
        echo "Download failed; switching mirror and retrying ($((attempt + 1))/3)."
        if [[ ! -e $mirrorlist.kiln-original ]]; then
            cp -- "$mirrorlist" "$mirrorlist.kiln-original" || { rm -f "$output"; return 1; }
        fi
        case $attempt in
            1) server='https://mirrors.kernel.org/archlinux/$repo/os/$arch' ;;
            2) server='https://geo.mirror.pkgbuild.com/$repo/os/$arch' ;;
        esac
        replacement=$(mktemp "$mirrorlist.kiln.XXXXXX") || { rm -f "$output"; return 1; }
        if ! { printf 'Server = %s\n' "$server"; cat "$mirrorlist"; } >"$replacement"; then
            rm -f "$replacement" "$output"
            return 1
        fi
        chmod --reference="$mirrorlist" "$replacement" && mv -f -- "$replacement" "$mirrorlist" || {
            rm -f "$replacement" "$output"; return 1;
        }
        sleep 2
    done
}

# Number of DISK's BIOS boot partition, if it has one.
bios_boot_part() {
    local name type
    while read -r name type; do
        if [[ ${type,,} == "$BIOS_BOOT_TYPE" ]]; then cat "/sys/class/block/${name##*/}/partition"; return; fi
    done < <(lsblk -lnpo NAME,PARTTYPE "$DISK")
}

partition_and_mount() {
    if [[ $SCHEME == auto ]]; then
        run wipefs -a "$DISK"
        # GPT: a 1 GiB EFI System Partition (U) for /boot, then Linux filesystem (L).
        # On BIOS, first a 1 MiB BIOS boot partition for the boot loader's stage 2.
        local layout=',1GiB,U\n,,L\n' first=1
        if [[ $FIRMWARE == bios ]]; then layout=",1MiB,$BIOS_BOOT_TYPE\n$layout" first=2; fi
        printf "label: gpt\n$layout" | run sfdisk --wipe always --wipe-partitions always "$DISK"
        udevadm settle
        ESP=$(part "$DISK" "$first") ROOT=$(part "$DISK" $((first + 1)))
        FORMAT_ESP=yes
        [[ -b $ESP && -b $ROOT ]] || { echo "partitions did not appear on $DISK"; return 1; }
    fi
    if [[ $FORMAT_ESP == yes ]]; then run mkfs.fat -F 32 -n KILN_ESP "$ESP"; fi
    local dev=$ROOT
    if [[ $ENCRYPT == yes ]]; then
        # Passphrase via stdin, never on a command line; no trailing newline, so it matches what is typed at boot.
        printf '%s' "$LUKS_PW" | run cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$ROOT"
        printf '%s' "$LUKS_PW" | run cryptsetup open --key-file - "$ROOT" "$CRYPT_NAME"
        dev=/dev/mapper/$CRYPT_NAME
    fi
    case $FS in
        ext4) run mkfs.ext4 -F -L kiln "$dev" ;;
        btrfs) run mkfs.btrfs -f -L kiln "$dev" ;;
    esac
    # -t: no probing, which makes the kernel log "couldn't mount as ext2/ext3".
    run mount -t "$FS" "$dev" "$MNT"
    # umask 0077: the ESP holds the boot loader random seed; keep it root-only.
    run mount --mkdir -t vfat -o fmask=0077,dmask=0077 "$ESP" "$MNT/boot"
}

install_base() {
    # mkinitcpio and iptables named explicitly: they are the defaults pacman would
    # pick among several providers anyway, but this skips its "choose a provider" prompts.
    local pkgs=(base "$KERNEL" linux-firmware mkinitcpio iptables dosfstools)
    case $FS in
        ext4) pkgs+=(e2fsprogs) ;;
        btrfs) pkgs+=(btrfs-progs) ;;
    esac
    case $BOOTLOADER in
        grub) pkgs+=(grub) ;;
        limine) pkgs+=(limine) ;;
    esac
    if [[ $BOOTLOADER != systemd-boot && $FIRMWARE == uefi ]]; then pkgs+=(efibootmgr); fi
    # CPU microcode; mkinitcpio's default "microcode" hook puts it in the initramfs.
    if grep -q GenuineIntel /proc/cpuinfo; then pkgs+=(intel-ucode); fi
    if grep -q AuthenticAMD /proc/cpuinfo; then pkgs+=(amd-ucode); fi
    # -K: a fresh pacman keyring in the target, not a copy of the live one.
    retry_downloads /etc/pacman.d/mirrorlist pacstrap -K "$MNT" "${pkgs[@]}"
    genfstab -U "$MNT" >>"$MNT/etc/fstab"
    echo "fstab:"
    grep -v '^#' "$MNT/etc/fstab" | sed '/^$/d'
}

install_kiln_files() {
    install -Dm755 "$(command -v kiln)" "$MNT/usr/local/bin/kiln"
    mkdir -p "$MNT$SHARE"
    cp -r "$SHARE/profiles" "$SHARE/repo" "$MNT$SHARE/"
    install -m644 "$SHARE/logo" "$MNT$SHARE/logo"
    install -Dm644 /etc/xdg/fastfetch/config.jsonc "$MNT/etc/xdg/fastfetch/config.jsonc"
    # Home skeleton (.xinitrc, .Xresources, .config); useradd copies it to the user.
    cp -rT "$SHARE/skel" "$MNT/etc/skel"
    install -Dm644 /etc/kiln/os-release "$MNT/etc/kiln/os-release"
    install -Dm644 /etc/pacman.d/hooks/kiln-os-release.hook "$MNT/etc/pacman.d/hooks/kiln-os-release.hook"
    cp -f /etc/kiln/os-release "$MNT/usr/lib/os-release"
    # Kiln's own packages (twmx) come from this local repository.
    # shortcut: the repo is a copy from the ISO, so these packages update only with a new Kiln release; host it online once there are users.
    cat >>"$MNT/etc/pacman.conf" <<'CONF'

# Kiln Linux packages (twmx), shipped with the install medium. Local and
# unsigned: the files are root-owned on this disk.
[kiln]
SigLevel = Optional TrustAll
Server = file:///usr/share/kiln/repo
CONF
    retry_downloads "$MNT/etc/pacman.d/mirrorlist" arch-chroot "$MNT" pacman -Syu --noconfirm # -u: never a partial upgrade
}

configure_system() {
    run arch-chroot "$MNT" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
    run arch-chroot "$MNT" hwclock --systohc
    grep -m1 "^${LOCALE//./\\.} " /usr/share/i18n/SUPPORTED >>"$MNT/etc/locale.gen"
    run arch-chroot "$MNT" locale-gen
    printf 'LANG=%s\n' "$LOCALE" >"$MNT/etc/locale.conf"
    printf 'KEYMAP=%s\n' "$KEYMAP" >"$MNT/etc/vconsole.conf"
    printf '%s\n' "$HOSTNAME_NEW" >"$MNT/etc/hostname"
    printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$HOSTNAME_NEW" >"$MNT/etc/hosts"
    # Clock sync (part of systemd, not enabled by Arch by default).
    run arch-chroot "$MNT" systemctl enable systemd-timesyncd.service
}

apply_profiles() {
    local p dm
    for p in core "$(desktop_field "$DESKTOP" 3)" "${EXTRAS[@]}"; do
        [[ $p == - ]] && continue
        retry_downloads "$MNT/etc/pacman.d/mirrorlist" arch-chroot "$MNT" kiln apply "$p" --yes
    done
    # kiln never enables services; the installer does, for what it installed.
    run arch-chroot "$MNT" systemctl enable NetworkManager.service
    dm=$(desktop_field "$DESKTOP" 4)
    if [[ $dm != - ]]; then run arch-chroot "$MNT" systemctl enable "$dm.service"; fi
    # ~/.xinitrc starts twmx; point it at the chosen X11 window manager.
    if [[ $DESKTOP == i3 ]]; then sed -i 's/^wm=twmx$/wm=i3/' "$MNT/etc/skel/.xinitrc"; fi
    # Window managers have no login screen: start the desktop on a tty1 login.
    local start
    start=$(desktop_field "$DESKTOP" 6)
    if [[ $start != - ]]; then
        cat >>"$MNT/etc/skel/.bash_profile" <<PROFILE

# Kiln Linux: start the desktop when logging in on tty1.
# Delete these lines to stay on the console; other ttys (Ctrl+Alt+F2) never start it.
if [ -z "\$DISPLAY" ] && [ -z "\$WAYLAND_DISPLAY" ] && [ "\$(tty)" = /dev/tty1 ]; then
    exec $start
fi
PROFILE
    fi
}

create_user() {
    run arch-chroot "$MNT" useradd -m -G wheel -s /bin/bash "$USER_NAME"
    # Passwords via stdin, never on a command line (visible in ps).
    printf '%s:%s\n' "$USER_NAME" "$USER_PW" | arch-chroot "$MNT" chpasswd
    if [[ -n $ROOT_PW ]]; then
        printf 'root:%s\n' "$ROOT_PW" | arch-chroot "$MNT" chpasswd
    else
        run arch-chroot "$MNT" passwd -l root
    fi
    install -Dm440 /dev/stdin "$MNT/etc/sudoers.d/10-wheel" <<<'%wheel ALL=(ALL:ALL) ALL'
    run arch-chroot "$MNT" visudo -cf /etc/sudoers.d/10-wheel
}

# The file holding the kernel command line of the chosen boot loader.
bootcfg() {
    case $BOOTLOADER in
        systemd-boot) echo "$MNT/boot/loader/entries/kiln.conf" ;;
        grub) echo "$MNT/boot/grub/grub.cfg" ;;
        limine) echo "$MNT/boot/limine.conf" ;;
    esac
}

# boot_hook PACKAGE COMMAND: a pacman hook in the new system that runs COMMAND
# after upgrades of PACKAGE, so the boot loader on the disk matches the package.
boot_hook() {
    install -Dm644 /dev/stdin "$MNT/etc/pacman.d/hooks/kiln-$1.hook" <<HOOK
[Trigger]
Operation = Upgrade
Type = Package
Target = $1

[Action]
Description = Updating $1 on the boot disk...
When = PostTransaction
Exec = /bin/sh -c '$2'
HOOK
}

install_bootloader() {
    local uuid luks= options
    uuid=$(findmnt -no UUID "$MNT")
    [[ -n $uuid ]] || { echo "cannot determine the root filesystem UUID"; return 1; }
    if [[ $ENCRYPT == yes ]]; then
        # Arch's default initramfs is systemd-based; sd-encrypt reads rd.luks.name and asks for the passphrase.
        grep -Eq '^HOOKS=.*\bsystemd\b' "$MNT/etc/mkinitcpio.conf" || { echo "mkinitcpio HOOKS are not systemd-based; cannot add sd-encrypt"; return 1; }
        sed -i '/^HOOKS=/s/\bfilesystems\b/sd-encrypt filesystems/' "$MNT/etc/mkinitcpio.conf"
        luks="rd.luks.name=$(cryptsetup luksUUID "$ROOT")=$CRYPT_NAME"
    fi
    options="${luks:+$luks }root=UUID=$uuid rw"
    # Regenerate the initramfs now that vconsole.conf exists (sd-vconsole hook).
    run arch-chroot "$MNT" mkinitcpio -P
    case $BOOTLOADER in
        systemd-boot) install_systemd_boot "$options" ;;
        grub) install_grub "$luks" ;;
        limine) install_limine "$options" ;;
    esac
}

# Hooks find the disk under /boot again at upgrade time: device names can change between boots.
readonly HOOK_BOOTDISK='d=$(lsblk -npo PKNAME "$(findmnt -no SOURCE /boot)")'

install_grub() {
    # GRUB adds root= itself; it only needs the LUKS option.
    sed -i -e "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$1\"|" -e 's|^GRUB_TIMEOUT=.*|GRUB_TIMEOUT=3|' \
        -e 's|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR="Kiln"|' "$MNT/etc/default/grub"
    if [[ $FIRMWARE == uefi ]]; then
        local efi='grub-install --target=x86_64-efi --efi-directory=/boot'
        run arch-chroot "$MNT" $efi --bootloader-id=Kiln
        # Also the fallback path EFI/BOOT/BOOTX64.EFI, for firmware that forgets boot entries.
        run arch-chroot "$MNT" $efi --removable
        boot_hook grub "$efi --bootloader-id=Kiln && $efi --removable"
    else
        run arch-chroot "$MNT" grub-install --target=i386-pc "$DISK"
        boot_hook grub "$HOOK_BOOTDISK"' && grub-install --target=i386-pc "$d"'
    fi
    run arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
}

install_limine() {
    cat >"$MNT/boot/limine.conf" <<CONF
timeout: 3

/Kiln Linux
    protocol: linux
    path: boot():/vmlinuz-$KERNEL
    module_path: boot():/initramfs-$KERNEL.img
    cmdline: $1
CONF
    local src=/usr/share/limine n
    if [[ $FIRMWARE == uefi ]]; then
        install -Dm644 "$MNT$src/BOOTX64.EFI" "$MNT/boot/EFI/limine/BOOTX64.EFI"
        install -Dm644 "$MNT$src/BOOTX64.EFI" "$MNT/boot/EFI/BOOT/BOOTX64.EFI"
        n=$(cat "/sys/class/block/${ESP##*/}/partition")
        run arch-chroot "$MNT" efibootmgr --create --disk "$DISK" --part "$n" --label "Kiln Linux" --loader '\EFI\limine\BOOTX64.EFI'
        boot_hook limine "cp $src/BOOTX64.EFI /boot/EFI/limine/ && cp $src/BOOTX64.EFI /boot/EFI/BOOT/"
    else
        install -m644 "$MNT$src/limine-bios.sys" "$MNT/boot/limine-bios.sys"
        n=$(bios_boot_part)   # empty on MBR disks
        run arch-chroot "$MNT" limine bios-install "$DISK" ${n:+"$n"}
        boot_hook limine "$HOOK_BOOTDISK && cp $src/limine-bios.sys /boot/ && limine bios-install \"\$d\"${n:+ $n}"
    fi
}

install_systemd_boot() {
    local options=$1
    run arch-chroot "$MNT" bootctl install --esp-path=/boot
    printf 'default kiln.conf\ntimeout 3\neditor no\n' >"$MNT/boot/loader/loader.conf"
    # One entry: Arch's linux preset no longer builds a fallback initramfs.
    cat >"$MNT/boot/loader/entries/kiln.conf" <<EOF
title   Kiln Linux
linux   /vmlinuz-$KERNEL
initrd  /initramfs-$KERNEL.img
options $options
EOF
    # Updates systemd-boot on the ESP after systemd package upgrades.
    run arch-chroot "$MNT" systemctl enable systemd-boot-update.service
}

# Check the result instead of assuming it. Fails if any check fails.
validate() {
    local uuid ok=1
    uuid=$(findmnt -no UUID "$MNT")
    check() {
        if "${@:2}" >/dev/null 2>&1; then echo "  ok    $1"; else echo "  FAIL  $1"; ok=0; fi
    }
    check "/boot/vmlinuz-$KERNEL exists" test -s "$MNT/boot/vmlinuz-$KERNEL"
    check "/boot/initramfs-$KERNEL.img exists" test -s "$MNT/boot/initramfs-$KERNEL.img"
    case $BOOTLOADER in
        systemd-boot) check "systemd-boot installed" arch-chroot "$MNT" bootctl --esp-path=/boot is-installed ;;
        grub) [[ $FIRMWARE == uefi ]] || check "GRUB BIOS core image" test -s "$MNT/boot/grub/i386-pc/core.img" ;;
        limine) [[ $FIRMWARE == uefi ]] || check "Limine BIOS stage /boot/limine-bios.sys" test -s "$MNT/boot/limine-bios.sys" ;;
    esac
    if [[ $FIRMWARE == uefi ]]; then
        check "fallback loader EFI/BOOT/BOOTX64.EFI" test -s "$MNT/boot/EFI/BOOT/BOOTX64.EFI"
    fi
    # grub-mkconfig may name the unlocked root by its /dev/mapper path instead of the UUID.
    check "boot entry points at root" grep -Eq "root=(UUID=$uuid|/dev/mapper/$CRYPT_NAME)( |\$)" "$(bootcfg)"
    check "fstab mounts root by UUID" grep -Eq "^UUID=$uuid[[:space:]]+/[[:space:]]" "$MNT/etc/fstab"
    check "fstab mounts /boot" grep -Eq '^[^#][^[:space:]]*[[:space:]]+/boot[[:space:]]' "$MNT/etc/fstab"
    check "user $USER_NAME exists" arch-chroot "$MNT" id -u "$USER_NAME"
    check "os-release says Kiln Linux" grep -q '^ID=kiln' "$MNT/usr/lib/os-release"
    check "kiln doctor passes" arch-chroot "$MNT" kiln doctor
    if [[ $ENCRYPT == yes ]]; then
        check "initramfs hooks include sd-encrypt" grep -Eq '^HOOKS=.*\bsd-encrypt\b' "$MNT/etc/mkinitcpio.conf"
        check "boot entry unlocks the LUKS root" grep -q "rd.luks.name=$(cryptsetup luksUUID "$ROOT")=$CRYPT_NAME" "$(bootcfg)"
    fi
    ((ok))
}

install_all() {
    set -Eeo pipefail
    trap 'echo "FAILED: line $LINENO: $BASH_COMMAND"' ERR
    echo "== [1/8] Partitioning and formatting";   partition_and_mount
    echo "== [2/8] Installing the base system";    install_base
    echo "== [3/8] Adding Kiln";                   install_kiln_files
    echo "== [4/8] Configuring";                   configure_system
    echo "== [5/8] Installing profiles";           apply_profiles
    echo "== [6/8] Creating accounts";             create_user
    echo "== [7/8] Installing the boot loader";    install_bootloader
    echo "== [8/8] Checking the installed system"; validate
    sync
    run umount -R "$MNT"
    if [[ $ENCRYPT == yes ]]; then run cryptsetup close "$CRYPT_NAME"; fi
}

# Run install_all, logging everything. Returns its status.
do_install() {
    : >"$LOG"
    if mountpoint -q "$MNT"; then
        echo "$MNT is already mounted; unmount it first (umount -R $MNT)." | tee -a "$LOG"
        return 1
    fi
    # Keep kernel messages from drawing over the screen; only errors get through.
    local level rc
    level=$(cut -f1 /proc/sys/kernel/printk)
    dmesg --console-level err 2>/dev/null || true
    if [[ -n $UNATTENDED ]]; then
        (install_all) 2>&1 | tee -a "$LOG"
    else
        (install_all) 2>&1 | tee -a "$LOG" |
            dialog --backtitle "$BT" --title "Installing Kiln Linux (log: $LOG)" --progressbox 22 78
    fi
    rc=${PIPESTATUS[0]}
    dmesg --console-level "$level" 2>/dev/null || true
    return "$rc"
}

summary() {
    if [[ -z $DISK ]]; then
        printf 'Disk:        NOT SELECTED\n'
    elif [[ $SCHEME == auto ]]; then
        printf 'Disk:        ERASE all of %s\n' "$DISK"
    else
        printf 'Disk:        %s (root, formatted), %s (/boot%s)\n' "$ROOT" "$ESP" "$([[ $FORMAT_ESP == yes ]] && echo ", formatted")"
    fi
    printf 'Filesystem:  %s%s\n' "$FS" "$([[ $ENCRYPT == yes ]] && echo ", encrypted (LUKS2)")"
    printf 'Kernel:      %s\n' "$KERNEL"
    printf 'Desktop:     %s\n' "$(desktop_field "$DESKTOP" 2)"
    printf 'Profiles:    core %s %s\n' "$(desktop_field "$DESKTOP" 3 | sed 's/^-$//')" "${EXTRAS[*]}"
    printf 'User:        %s (sudo); root %s\n' "$USER_NAME" "$([[ -n $ROOT_PW ]] && echo "password set" || echo locked)"
    printf 'Hostname:    %s\n' "$HOSTNAME_NEW"
    printf 'Keyboard:    %s; locale %s; time zone %s\n' "$KEYMAP" "$LOCALE" "$TIMEZONE"
    printf 'Boot loader: %s (%s)\n' "$BOOTLOADER" "${FIRMWARE^^}"
    printf '\nAfter installing: reboot, then %s.\n' "$(desktop_field "$DESKTOP" 5)"
}

main_menu() {
    local disk_desc="[required] choose a disk" net status
    local -a missing=()
    [[ -n $DISK && $SCHEME == auto ]] && disk_desc="ERASE $DISK, $FS"
    [[ -n $DISK && $SCHEME == manual ]] && disk_desc="$ROOT + $ESP, $FS"
    [[ -n $DISK && $ENCRYPT == yes ]] && disk_desc+=", encrypted"
    if online; then net=connected; else net="[required] connect to internet"; missing+=(network); fi
    [[ -n $USER_NAME && -n $USER_PW ]] || missing+=("user account")
    [[ -n $DISK && -n $SCHEME ]] || missing+=("destination disk")
    if ((${#missing[@]})); then
        status=$(printf '%s, ' "${missing[@]}")
        status="Still needed: ${status%, }"
    else
        status="Required choices set. Review your settings before installing."
    fi
    d --title "Kiln Linux / ${FIRMWARE^^}" --no-tags --ok-label Choose --cancel-label Exit \
        --default-item "$next" --item-help \
        --menu "$status\nDefaults are ready to use. Select any item to change it." 23 78 12 \
        keyboard   "Keyboard      $KEYMAP" "Console keyboard layout" \
        network    "Network       $net" "Internet is required to download packages" \
        hostname   "Hostname      $HOSTNAME_NEW" "The name of this computer on your network" \
        locale     "Locale        $LOCALE" "System language and character encoding" \
        timezone   "Timezone      $TIMEZONE" "Local time zone" \
        root       "Root          $([[ -n $ROOT_PW ]] && echo "password set" || echo "locked; use sudo")" "Your user can administer the system with sudo" \
        user       "User account  ${USER_NAME:-[required] create your login}" "Create the account you will log in with" \
        desktop    "Desktop       $(desktop_field "$DESKTOP" 2)" "Choose a desktop or a console-only installation" \
        extras     "Extras        ${EXTRAS[*]:-none}" "Optional audio and developer packages" \
        kernel     "Kernel        $KERNEL" "Linux kernel package; linux is the default" \
        disk       "Disk          $disk_desc" "Choose partitions, filesystem and optional encryption" \
        bootloader "Boot loader   $BOOTLOADER" "Boot loader for this computer's firmware" \
        review     "Review        All settings and planned disk changes" "Review without starting the installation" \
        install    "Install       Check settings and confirm disk changes" "Final review and disk confirmation are required" \
        log        "Log           View the full installation log" "Use arrow keys to scroll; no log before the first attempt" \
        help       "Help          Navigation and installation guidance" "Keyboard shortcuts, defaults and disk safety"
}

confirm_disk_changes() {
    local target=$DISK action="Everything on $DISK will be erased."
    if [[ $SCHEME == manual ]]; then
        target=$ROOT
        action="All data on $ROOT will be erased."
        [[ $FORMAT_ESP != yes ]] || action+="\n$ESP will also be formatted."
    fi
    local typed
    typed=$(d --title "Confirm disk changes" --inputbox "$action\n\nType $target to confirm:" 12 74) || return 1
    [[ $typed == "$target" ]] && return 0
    d --title "Not confirmed" --msgbox "Formatting was not confirmed. Return to Disk to check your selection." 8 68
    return 1
}

installer_help() {
    d --title "Using the Kiln installer" --msgbox \
        "Use Up/Down to select a setting, Enter to open it, and Tab to switch buttons. Escape goes back.\n\nKeep the defaults unless you want to change them. A user account, internet connection and destination disk are required.\n\nReview shows your choices. Install checks them, then asks you to confirm the disk or partition name before formatting.\n\nManual partitioning opens cfdisk: changes saved there take effect immediately.\n\nIf installation fails, Log shows the full output. Unmount the target before starting another attempt." 22 76
}

# --- Main --------------------------------------------------------------------

((EUID == 0)) || { echo "kiln-install: run as root" >&2; exit 1; }
for c in dialog pacstrap genfstab arch-chroot sfdisk cfdisk wipefs cryptsetup mkfs.fat mkfs.ext4 mkfs.btrfs lsblk findmnt kiln; do
    command -v "$c" >/dev/null || { echo "kiln-install: missing command: $c" >&2; exit 1; }
done
[[ -d $SHARE/profiles && -f $SHARE/repo/kiln.db ]] || { echo "kiln-install: missing $SHARE/profiles or $SHARE/repo" >&2; exit 1; }

if [[ ${1-} == --config ]]; then
    [[ -r ${2-} ]] || { echo "usage: kiln-install --config FILE" >&2; exit 1; }
    UNATTENDED=1
    # shellcheck disable=SC1090
    . "$2"
    for ((i = 0; i < 60; i++)); do
        systemctl is-active -q pacman-init.service && break
        sleep 1
    done
    problem=$(settings_problem)
    [[ -z $problem ]] || die "$problem"
    summary
    # Keep do_install outside a conditional so install_all retains errexit.
    do_install
    if (($? == 0)); then
        echo "Kiln Linux is installed on $DISK."
        exit 0
    fi
    echo "Installation FAILED. Kiln Linux is NOT installed. Log: $LOG" >&2
    exit 1
fi

if [[ -r /etc/kiln/dialogrc ]]; then export DIALOGRC=/etc/kiln/dialogrc; fi
next=user
while true; do
    choice=$(main_menu) || {
        if d --title "Exit installer?" --defaultno --yes-label Exit --no-label "Keep editing" \
            --yesno "Leave the installer? Your current menu choices will be lost." 8 64; then
            clear
            exit 0
        fi
        continue
    }
    case $choice in
        keyboard) ask_keymap; next=network ;;
        network) ask_network; next=hostname ;;
        hostname) ask_hostname; next=locale ;;
        locale) ask_locale; next=timezone ;;
        timezone) ask_timezone; next=root ;;
        root) ask_root_password; next=user ;;
        user) ask_user; next=desktop ;;
        desktop) ask_desktop; next=extras ;;
        extras) ask_extras; next=kernel ;;
        kernel) ask_kernel; next=disk ;;
        disk) ask_disk; next=install ;;
        bootloader) ask_bootloader; next=install ;;
        review) d --title "Review / planned disk changes" --msgbox "$(summary)" 22 78; next=install ;;
        log)
            if [[ -s $LOG ]]; then
                d --title "Installation log / scroll with arrow keys" --textbox "$LOG" 22 78
            else
                d --title "Installation log" --msgbox "No installation has been started in this session." 7 64
            fi
            ;;
        help) installer_help ;;
        install)
            problem=$(settings_problem)
            if [[ -n $problem ]]; then
                d --title "Not ready" --msgbox "$problem" 8 64
                continue
            fi
            d --title "Install Kiln Linux?" --defaultno --yes-label Install --no-label Back \
                --yesno "$(summary)" 20 76 || continue
            confirm_disk_changes || continue
            # Keep do_install outside a conditional so install_all retains errexit.
            do_install
            if (($? == 0)); then
                if d --title Done --yes-label Reboot --no-label Exit --yesno \
                    "Kiln Linux is installed.\n\n$(summary | tail -n1)\n\nRemove the install medium, then reboot." 11 66; then
                    clear
                    systemctl reboot
                fi
                clear
                exit 0
            fi
            d --title "Installation FAILED" --msgbox "Kiln Linux is NOT installed.\n\nLog: $LOG\n\nThe full log follows; use the arrow keys to scroll through the download errors.\n\nFilesystems may be left mounted under $MNT; unmount with umount -R $MNT (and cryptsetup close $CRYPT_NAME if encrypted) before retrying." 22 78
            d --title "Full installation log (scroll to see download errors)" --textbox "$LOG" 22 78
            next=install
            ;;
    esac
done
